 * GENERATED by build.py from logic.js + backend/server.gs. Do not edit here.
 *
 * HOW TO DEPLOY:
 * 1. Open your Google Sheet -> Extensions -> Apps Script
 * 2. Delete everything in Code.gs and paste this entire file
 * 3. Deploy -> New deployment -> Web app
 *    Execute as = Me, Who has access = Anyone
 *    (when updating: Deploy -> Manage deployments -> Edit -> New version)
 * 4. Copy the Web App URL into the app (Admin -> ຕັ້ງຄ່າ Google Sheet)
 * 5. Log in as admin (first time: admin / admin123) and change the password at once.
 */

/* ==========================================================================
   0. Shared Rules — runs in the app AND in Google Apps Script (copied into
   GoogleAppsScript.gs by build.py). Every change to the data goes
   through Logic.apply(state, {type, args}, ctx), so the server enforces the
   same rules the app shows. Keep this plain JavaScript (no DOM, no ?. / ??).
   ========================================================================== */

const RENT = 3500000;
const GARBAGE = 80000; // fixed monthly garbage fee (kip)
const MAX_ROOMS = 50;
const DEFAULT_PIN = "1234"; // used when the admin adds a tenant without choosing a PIN

const FIELDS = [
  ["name", "ຊື່ ແລະ ນາມສະກຸນ"],
  ["dob", "ວັນເດືອນປີເກີດ"],
  ["phone", "ເບີໂທ"],
  ["idno", "ເລກບັດປະຊາຊົນ / ໜັງສືຜ່ານແດນ"],
  ["emerg", "ຜູ້ຕິດຕໍ່ສຸກເສີນ"],
  ["elec", "ເລກມິເຕີໄຟຟ້າ"],
  ["water", "ເລກບິນນ້ຳ"]
];

// Profile fields only the admin can change (tenants see them read-only).
const ADMIN_ONLY = ["elec", "water"];

// What a payment slip is for. Payments saved before this existed count as rent.
const PAY_KINDS = [
  ["rent", "ຄ່າເຊົ່າ", "Rent"],
  ["elec", "ຄ່າໄຟຟ້າ", "Electric"],
  ["water", "ຄ່ານ້ຳ", "Water"],
  ["garbage", "ຄ່າຂີ້ເຫຍື້ອ", "Garbage"]
];
const kindLabel = k => (PAY_KINDS.find(x => x[0] === k) || PAY_KINDS[0])[1];
// How the admin received a payment they record by hand.
const PAY_METHODS = { cash: "ເງິນສົດ", transfer: "ໂອນ" };
const methodLabel = p => (p.manual ? PAY_METHODS[p.method || "cash"] || PAY_METHODS.cash : "");

// One slip can cover several types: p.items = { rent: 3500000, water: 50000 }.
const kindsOf = p => (p.items ? Object.keys(p.items) : [p.kind || "rent"]);
const hasKind = (p, k) => kindsOf(p).indexOf(k) >= 0;
const kindsLabel = p => kindsOf(p).map(kindLabel).join(" + ");
// Amount of one type on a slip (older single-type slips use kind, or nothing = rent).
const amtFor = (p, k) => (p.items ? Number(p.items[k]) || 0 : (p.kind || "rent") === k ? Number(p.amount) || 0 : 0);

const Logic = (function () {
  // Tenants cannot change their own PIN; only the admin sets it (editTenant).
  const TENANT_ACTIONS = ["profile", "dismiss", "slip"];
  const ADMIN_ACTIONS = [
    "decideProfile", "decidePay", "undoPay", "delPay", "recordPay", "addRooms", "editRoom", "delRoom",
    "moveIn", "moveOut", "editTenant", "adminPass"
  ];

  function fail(msg) {
    throw new Error(msg);
  }
  const num = v => parseInt(String(v === undefined || v === null ? "" : v).replace(/\D/g, ""), 10) || 0;
  const text = (v, max) => String(v === undefined || v === null ? "" : v).trim().slice(0, max || 200);
  const isDate = v => /^\d{4}-\d{2}-\d{2}$/.test(String(v || ""));
  const roomOf = (S, n) => S.rooms.find(r => r.n === n);

  function normalize(S) {
    S.rooms = S.rooms || [];
    S.pay = S.pay || [];
    S.payArchive = S.payArchive || [];
    S.pending = S.pending || [];
    S.notices = S.notices || {};
    S.pastTenants = S.pastTenants || [];
    S.admin = S.admin || {};
    S.nid = S.nid || 1000;
    return S;
  }

  function sortRooms(S) {
    S.rooms.sort((a, b) => {
      if ((a.floor || 1) !== (b.floor || 1)) return (a.floor || 1) - (b.floor || 1);
      const x = Number(a.n), y = Number(b.n);
      if (!isNaN(x) && !isNaN(y)) return x - y;
      return a.n < b.n ? -1 : a.n > b.n ? 1 : 0;
    });
  }

  // A "due" override only applies to the month it is for; otherwise the rent is due.
  const dueActive = (r, month) => !!(r && r.due && r.dueMonth === month);
  const dueFor = (r, month) => (dueActive(r, month) ? r.due : r.rent);
  function setDue(r, due, month) {
    if (due && due !== r.rent) {
      r.due = due;
      r.dueMonth = month;
    } else {
      delete r.due;
      delete r.dueMonth;
    }
  }

  function prevMonth(m) {
    const y = Number(m.slice(0, 4)), mo = Number(m.slice(5, 7));
    return mo === 1 ? y - 1 + "-12" : y + "-" + String(mo - 1).padStart(2, "0");
  }

  function nextMonth(m) {
    const y = Number(m.slice(0, 4)), mo = Number(m.slice(5, 7));
    return mo === 12 ? y + 1 + "-01" : y + "-" + String(mo + 1).padStart(2, "0");
  }

  // Paying ahead (next month) is for the fixed amounts only: bills for electricity
  // and water are not known yet.
  const ADVANCE_KINDS = ["rent", "garbage"];

  // Ids come from the device (so an offline action and its later references agree),
  // falling back to a server counter if that id is already taken.
  function newId(S, a) {
    const id = Number(a.id);
    const taken = x => S.pay.some(p => p.id === x) || S.pending.some(p => p.id === x);
    if (id && !taken(id)) return id;
    while (taken(S.nid)) S.nid++;
    return S.nid++;
  }

  // Images must be a real base64 photo (uploaded to Drive on the server) — never
  // arbitrary text, which could break out of an <img> tag on the admin's screen.
  function cleanImg(v, allowEmpty) {
    v = String(v || "");
    if (!v) {
      if (allowEmpty) return "";
      fail("ກະລຸນາອັບໂຫຼດຮູບ");
    }
    if (v.length < 4e6 && /^data:image\/(jpeg|png|webp|gif);base64,[A-Za-z0-9+/=]+$/.test(v)) return v;
    fail("ຮູບບໍ່ຖືກຕ້ອງ");
  }

  function tenantRoom(S, ctx) {
    const r = roomOf(S, ctx.room);
    if (!r || !r.t) fail("ບໍ່ພົບຫ້ອງຂອງທ່ານ");
    return r;
  }

  const A = {};

  /* ---------- Tenant actions (always for the tenant's own room) ---------- */

  // Profile change request; the admin approves it. merge: add to an existing request.
  A.profile = (S, a, ctx) => {
    const r = tenantRoom(S, ctx);
    const t = r.t;
    const ch = {};
    const allowed = FIELDS.map(f => f[0]).filter(k => ADMIN_ONLY.indexOf(k) < 0);
    const src = a.ch || {};
    allowed.forEach(k => {
      if (src[k] === undefined) return;
      const v = text(src[k]);
      if (v !== (t[k] || "")) ch[k] = v;
    });
    if (src.photo !== undefined && src.photo !== t.photo) {
      const img = cleanImg(src.photo, true);
      ch.photo = img ? ctx.upload(img, "profile_room_" + r.n) : "";
    }
    if (ch.name !== undefined && !ch.name) fail("ກະລຸນາໃສ່ຊື່");
    const prev = S.pending.find(p => p.room === r.n);
    if (a.merge && prev) {
      Object.assign(prev.ch, ch);
      prev.ts = ctx.now;
    } else {
      S.pending = S.pending.filter(p => p.room !== r.n);
      if (Object.keys(ch).length) S.pending.push({ id: newId(S, a), room: r.n, ts: ctx.now, ch: ch });
    }
    delete S.notices[r.n];
    return { changed: Object.keys(ch).length };
  };

  A.dismiss = (S, a, ctx) => {
    delete S.notices[tenantRoom(S, ctx).n];
  };

  A.slip = (S, a, ctx) => {
    const r = tenantRoom(S, ctx);
    const kinds = PAY_KINDS.map(x => x[0]).filter(k => (a.kinds || []).indexOf(k) >= 0);
    if (!kinds.length) fail("ກະລຸນາເລືອກປະເພດການຊຳລະ");
    // The month is checked against the server's clock: a phone with a wrong date
    // cannot file a slip under another month. Allowed: this month, next month (paying
    // ahead), and — early in a new month — last month, for a slip queued offline.
    const m = String(a.month || ctx.month);
    const ahead = m === nextMonth(ctx.month);
    const ok = m === ctx.month || ahead || (m === prevMonth(ctx.month) && ctx.day <= 3);
    if (!ok && /^\d{4}-\d{2}$/.test(m) && m > nextMonth(ctx.month)) fail("ຈ່າຍລ່ວງໜ້າໄດ້ພຽງ 1 ເດືອນ");
    if (!ok) fail("ວັນທີໃນໂທລະສັບບໍ່ຖືກຕ້ອງ. ກະລຸນາກວດສອບວັນທີ ແລ້ວລອງໃໝ່.");
    if (ahead && kinds.some(k => ADVANCE_KINDS.indexOf(k) < 0))
      fail("ຈ່າຍລ່ວງໜ້າໄດ້ສະເພາະ ຄ່າເຊົ່າ ແລະ ຄ່າຂີ້ເຫຍື້ອ");
    const img = cleanImg(a.img);
    const items = {};
    kinds.forEach(k => {
      const v = k === "rent" ? dueFor(r, m) : k === "garbage" ? GARBAGE : num((a.amts || {})[k]);
      if (!v) fail(k === "rent" ? "ແອດມິນຍັງບໍ່ໄດ້ກຳນົດຍອດ" : "ກະລຸນາໃສ່ຈຳນວນເງິນ" + kindLabel(k));
      if (v > 50000000) fail("ຈຳນວນເງິນ" + kindLabel(k) + " ບໍ່ຖືກຕ້ອງ");
      items[k] = v;
    });
    const monthSlips = S.pay.filter(p => p.room === r.n && p.month === m);
    const paid = kinds.find(k => monthSlips.some(p => p.status === "confirmed" && hasKind(p, k)));
    if (paid) fail(kindLabel(paid) + " ເດືອນນີ້ຊຳລະແລ້ວ");
    // An earlier unconfirmed slip is replaced only when this one covers everything it
    // did; otherwise the types not being resent would be lost.
    const overlap = monthSlips.filter(p => p.status !== "confirmed" && kinds.some(k => hasKind(p, k)));
    const partial = overlap.find(p => p.status === "pending" && !kindsOf(p).every(k => kinds.indexOf(k) >= 0));
    if (partial) fail("ມີສະລິບ " + kindsLabel(partial) + " ລໍຖ້າກວດສອບຢູ່ແລ້ວ");
    const replace = overlap.filter(p => kindsOf(p).every(k => kinds.indexOf(k) >= 0)).map(p => p.id);
    S.pay = S.pay.filter(p => replace.indexOf(p.id) < 0);
    const id = newId(S, a);
    S.pay.push({
      id: id,
      room: r.n,
      month: m,
      items: items,
      amount: Object.keys(items).reduce((s, k) => s + items[k], 0),
      img: ctx.upload(img, "slip_room_" + r.n + "_" + m + "_" + id),
      ts: ctx.now,
      status: "pending"
    });
  };

  /* ---------- Admin actions ---------- */

  A.decideProfile = (S, a, ctx) => {
    const p = S.pending.find(x => x.id === a.id);
    if (!p) fail("ຄຳຂໍນີ້ຖືກກວດສອບແລ້ວ");
    const r = roomOf(S, p.room);
    if (a.ok && r && r.t) {
      const ch = Object.assign({}, p.ch);
      ADMIN_ONLY.forEach(k => delete ch[k]);
      Object.assign(r.t, ch);
    }
    S.notices[p.room] = {
      ok: !!a.ok,
      msg: a.ok ? "ໂປຣໄຟລ໌ຂອງທ່ານຖືກອັບເດດແລ້ວ." : text(a.reason, 300) || "ກະລຸນາກວດສອບຂໍ້ມູນແລ້ວລອງໃໝ່ ຫຼື ຕິດຕໍ່ຫ້ອງການ.",
      ts: ctx.now
    };
    S.pending = S.pending.filter(x => x.id !== a.id);
  };

  // Approve or reject a slip. When approving, the admin may correct the electricity
  // and water amounts typed by the tenant (rent and garbage are fixed).
  A.decidePay = (S, a, ctx) => {
    const p = S.pay.find(x => x.id === a.id);
    if (!p) fail("ບໍ່ພົບສະລິບ");
    if (p.status !== "pending") fail("ສະລິບນີ້ຖືກກວດສອບແລ້ວ");
    if (a.ok) {
      if (a.amts && p.items) {
        ["elec", "water"].forEach(k => {
          if (p.items[k] === undefined || a.amts[k] === undefined) return;
          const v = num(a.amts[k]);
          if (!v) fail("ກະລຸນາໃສ່ຈຳນວນເງິນ" + kindLabel(k));
          p.items[k] = v;
        });
        p.amount = Object.keys(p.items).reduce((s, k) => s + p.items[k], 0);
      }
      p.status = "confirmed";
      delete p.reason;
    } else {
      p.status = "rejected";
      p.reason = text(a.reason, 300);
    }
    p.decidedAt = ctx.now;
  };

  // Undo an approval made by mistake: the slip goes back to "waiting". A payment the
  // admin recorded by hand has no tenant slip to go back to, so it is removed.
  // Delete a payment record from history (any status, current or moved-out tenant).
  A.delPay = (S, a) => {
    const before = S.pay.length + S.payArchive.length;
    S.pay = S.pay.filter(p => p.id !== a.id);
    S.payArchive = S.payArchive.filter(p => p.id !== a.id);
    if (S.pay.length + S.payArchive.length === before) fail("ບໍ່ພົບລາຍການ");
  };

  A.undoPay = (S, a) => {
    const p = S.pay.find(x => x.id === a.id);
    if (!p) fail("ບໍ່ພົບສະລິບ");
    if (p.status !== "confirmed") fail("ສະລິບນີ້ຍັງບໍ່ໄດ້ອະນຸມັດ");
    if (p.manual) {
      S.pay = S.pay.filter(x => x.id !== a.id);
      return;
    }
    p.status = "pending";
    delete p.reason;
    delete p.decidedAt;
  };

  // The admin records a payment received without a slip (cash, or a transfer the
  // tenant did not upload). It is saved as already paid.
  A.recordPay = (S, a, ctx) => {
    const r = roomOf(S, a.n);
    if (!r || !r.t) fail("ຫ້ອງນີ້ບໍ່ມີຜູ້ເຊົ່າ");
    const m = String(a.month || "");
    if (!/^\d{4}-\d{2}$/.test(m)) fail("ເດືອນບໍ່ຖືກຕ້ອງ");
    if (m > nextMonth(ctx.month)) fail("ບັນທຶກລ່ວງໜ້າໄດ້ພຽງ 1 ເດືອນ");
    const kinds = PAY_KINDS.map(x => x[0]).filter(k => (a.kinds || []).indexOf(k) >= 0);
    if (!kinds.length) fail("ກະລຸນາເລືອກປະເພດການຊຳລະ");
    const items = {};
    kinds.forEach(k => {
      const v = num((a.amts || {})[k]);
      if (!v) fail("ກະລຸນາໃສ່ຈຳນວນເງິນ" + kindLabel(k));
      if (v > 50000000) fail("ຈຳນວນເງິນ" + kindLabel(k) + " ບໍ່ຖືກຕ້ອງ");
      items[k] = v;
    });
    const monthSlips = S.pay.filter(p => p.room === r.n && p.month === m);
    const paid = kinds.find(k => monthSlips.some(p => p.status === "confirmed" && hasKind(p, k)));
    if (paid) fail(kindLabel(paid) + " ເດືອນນີ້ຊຳລະແລ້ວ");
    const waiting = monthSlips.find(p => p.status === "pending" && kinds.some(k => hasKind(p, k)));
    if (waiting) fail("ມີສະລິບ " + kindsLabel(waiting) + " ລໍຖ້າກວດສອບ. ກະລຸນາອະນຸມັດ ຫຼື ປະຕິເສດກ່ອນ.");
    // Rejected slips fully covered by this payment are no longer needed.
    S.pay = S.pay.filter(
      p => !(p.room === r.n && p.month === m && p.status === "rejected" && kindsOf(p).every(k => kinds.indexOf(k) >= 0))
    );
    const img = cleanImg(a.img, true);
    const id = newId(S, a);
    S.pay.push({
      id: id,
      room: r.n,
      month: m,
      items: items,
      amount: Object.keys(items).reduce((s2, k) => s2 + items[k], 0),
      img: img ? ctx.upload(img, "receipt_room_" + r.n + "_" + m + "_" + id) : "",
      ts: ctx.now,
      status: "confirmed",
      manual: true,
      method: PAY_METHODS[a.method] ? a.method : "cash",
      note: text(a.note, 200),
      decidedAt: ctx.now
    });
  };

  A.addRooms = (S, a) => {
    const first = num(a.num);
    const cnt = num(a.cnt) || 1;
    const rent = num(a.rent) || RENT;
    if (!first) fail("ກະລຸນາໃສ່ເລກຫ້ອງ");
    if (cnt < 1 || S.rooms.length + cnt > MAX_ROOMS) fail("ສູງສຸດ " + MAX_ROOMS + " ຫ້ອງ");
    for (let i = 0; i < cnt; i++) if (roomOf(S, String(first + i))) fail("ຫ້ອງ " + (first + i) + " ມີແລ້ວ");
    for (let i = 0; i < cnt; i++) S.rooms.push({ n: String(first + i), floor: 1, rent: rent, t: null });
    sortRooms(S);
  };

  A.editRoom = (S, a, ctx) => {
    const r = roomOf(S, a.old);
    if (!r) fail("ບໍ່ພົບຫ້ອງ");
    const nn = text(a.nn, 8).toUpperCase();
    const rent = num(a.rent);
    if (!/^[A-Z0-9-]{1,8}$/.test(nn)) fail("ເລກຫ້ອງບໍ່ຖືກຕ້ອງ");
    if (nn !== a.old && roomOf(S, nn)) fail("ຫ້ອງ " + nn + " ມີແລ້ວ");
    if (!rent) fail("ກະລຸນາໃສ່ຄ່າເຊົ່າທີ່ຖືກຕ້ອງ");
    r.floor = 1;
    r.rent = rent;
    setDue(r, num(a.due), ctx.month);
    if (nn !== a.old) {
      const old = a.old;
      r.n = nn;
      S.pending.concat(S.pay, S.payArchive).forEach(p => {
        if (p.room === old) p.room = nn;
      });
      if (S.notices[old]) {
        S.notices[nn] = S.notices[old];
        delete S.notices[old];
      }
    }
    sortRooms(S);
  };

  A.delRoom = (S, a) => {
    if (!roomOf(S, a.n)) fail("ບໍ່ພົບຫ້ອງ");
    S.rooms = S.rooms.filter(r => r.n !== a.n);
    S.pending = S.pending.filter(p => p.room !== a.n);
    S.pay = S.pay.filter(p => p.room !== a.n);
    S.payArchive = S.payArchive.filter(p => p.room !== a.n);
    delete S.notices[a.n];
  };

  // Part-month rent for a tenant moving in after the 1st: rent × days left ÷ days in
  // the month, rounded to 1,000 kip. Applies to the move-in month only.
  function prorated(rent, since) {
    const y = Number(since.slice(0, 4)), m = Number(since.slice(5, 7)), d = Number(since.slice(8, 10));
    const days = new Date(y, m, 0).getDate();
    return d > 1 ? Math.round((rent * (days - d + 1)) / days / 1000) * 1000 : 0;
  }

  A.moveIn = (S, a, ctx) => {
    const r = roomOf(S, a.n);
    if (!r) fail("ບໍ່ພົບຫ້ອງ");
    if (r.t) fail("ຫ້ອງນີ້ມີຜູ້ເຊົ່າແລ້ວ");
    const name = text(a.name, 100);
    const pin = String(a.pin || DEFAULT_PIN);
    if (!name) fail("ກະລຸນາໃສ່ຊື່");
    if (!/^\d{4,6}$/.test(pin)) fail("PIN ຕ້ອງມີ 4-6 ຕົວເລກ");
    const since = isDate(a.since) ? a.since : ctx.today;
    r.t = {
      name: name,
      dob: isDate(a.dob) ? a.dob : "",
      phone: text(a.phone, 40),
      idno: "",
      emerg: "",
      elec: "",
      water: "",
      since: since,
      photo: "",
      deposit: num(a.deposit),
      pinHash: ctx.hashPin(pin),
      pv: 0,
      tid: ctx.newTid()
    };
    delete S.notices[r.n];
    setDue(r, 0, ctx.month);
    if (a.prorate) {
      const part = prorated(r.rent, since);
      if (part) setDue(r, part, since.slice(0, 7));
    }
  };

  // Move out: the tenant is kept in "past tenants" with the deposit returned, and
  // their payments are archived so the next tenant starts clean.
  A.moveOut = (S, a, ctx) => {
    const r = roomOf(S, a.n);
    if (!r || !r.t) fail("ຫ້ອງນີ້ບໍ່ມີຜູ້ເຊົ່າ");
    const t = r.t;
    const deposit = t.deposit || 0;
    const refund = a.refund === undefined || a.refund === "" ? deposit : num(a.refund);
    S.pastTenants.push({
      room: r.n,
      name: t.name,
      phone: t.phone || "",
      idno: t.idno || "",
      since: t.since || "",
      out: isDate(a.out) ? a.out : ctx.today,
      deposit: deposit,
      refund: refund,
      note: text(a.note, 300)
    });
    S.payArchive = S.payArchive.concat(
      S.pay.filter(p => p.room === r.n).map(p => Object.assign({}, p, { archived: ctx.now }))
    );
    S.pay = S.pay.filter(p => p.room !== r.n);
    S.pending = S.pending.filter(p => p.room !== r.n);
    delete S.notices[r.n];
    setDue(r, 0, ctx.month);
    r.t = null;
  };

  A.editTenant = (S, a, ctx) => {
    const r = roomOf(S, a.n);
    if (!r || !r.t) fail("ຫ້ອງນີ້ບໍ່ມີຜູ້ເຊົ່າ");
    const f = a.f || {};
    const name = text(f.name, 100);
    const rent = num(a.rent);
    if (!name) fail("ກະລຸນາໃສ່ຊື່");
    if (!rent) fail("ກະລຸນາໃສ່ຄ່າເຊົ່າທີ່ຖືກຕ້ອງ");
    const pin = String(a.pin || "");
    if (pin && !/^\d{4,6}$/.test(pin)) fail("PIN ຕ້ອງມີ 4-6 ຕົວເລກ");
    FIELDS.forEach(x => (r.t[x[0]] = text(f[x[0]])));
    r.t.name = name;
    if (f.photo !== undefined && f.photo !== r.t.photo) {
      const img = cleanImg(f.photo, true);
      r.t.photo = img ? ctx.upload(img, "tenant_room_" + r.n) : "";
    }
    r.t.since = isDate(a.since) ? a.since : r.t.since;
    r.t.deposit = num(a.deposit);
    if (pin) {
      r.t.pinHash = ctx.hashPin(pin);
      r.t.pv = (r.t.pv || 0) + 1;
    }
    r.rent = rent;
    setDue(r, num(a.due), ctx.month);
  };

  A.adminPass = (S, a, ctx) => {
    if (!ctx.checkPass(S.admin.hash, String(a.old || ""))) fail("ລະຫັດຜ່ານປັດຈຸບັນບໍ່ຖືກຕ້ອງ");
    const user = text(a.user, 30) || S.admin.user;
    const pass = String(a.pass || "");
    if (user.length < 3) fail("ຊື່ຜູ້ໃຊ້ຕ້ອງມີຢ່າງໜ້ອຍ 3 ຕົວອັກສອນ");
    if (pass.length < 6) fail("ລະຫັດຜ່ານໃໝ່ຕ້ອງມີຢ່າງໜ້ອຍ 6 ຕົວອັກສອນ");
    if (pass === "admin123") fail("ກະລຸນາໃຊ້ລະຫັດຜ່ານອື່ນ");
    S.admin = { user: user, hash: ctx.hashPass(pass), v: (S.admin.v || 0) + 1, isDefault: false };
  };

  /* ---------- Entry points ---------- */

  function apply(S, action, ctx) {
    normalize(S);
    const type = action && action.type;
    const fn = A[type];
    if (!fn || !Object.prototype.hasOwnProperty.call(A, type)) fail("ຄຳສັ່ງບໍ່ຖືກຕ້ອງ");
    if (ADMIN_ACTIONS.indexOf(type) >= 0 && ctx.role !== "admin") fail("ບໍ່ມີສິດ");
    if (TENANT_ACTIONS.indexOf(type) >= 0 && ctx.role !== "tenant") fail("ບໍ່ມີສິດ");
    return fn(S, action.args || {}, ctx) || {};
  }

  function login(S, mode, id, secret, ctx) {
    normalize(S);
    if (mode === "admin") {
      if (text(id, 30) !== S.admin.user || !ctx.checkPass(S.admin.hash, String(secret || "")))
        fail("ຊື່ຜູ້ໃຊ້ ຫຼື ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ");
      return { role: "admin", av: S.admin.v || 0 };
    }
    const r = roomOf(S, text(id, 8).toUpperCase());
    if (!r || !r.t || !ctx.checkPin(r.t.pinHash, String(secret || ""))) fail("ເລກຫ້ອງ ຫຼື PIN ບໍ່ຖືກຕ້ອງ");
    return { role: "tenant", room: r.n, tid: r.t.tid, pv: r.t.pv || 0 };
  }

  // What each person is allowed to see: never PIN/password hashes; a tenant only
  // gets their own room, payments, requests and notices.
  function viewFor(S, role, roomN) {
    normalize(S);
    const strip = r => {
      const c = Object.assign({}, r);
      if (c.t) {
        c.t = Object.assign({}, c.t);
        delete c.pinHash;
        delete c.t.pinHash;
      }
      return c;
    };
    let v;
    if (role === "admin") {
      v = {
        rooms: S.rooms.map(strip),
        pay: S.pay,
        payArchive: S.payArchive,
        pending: S.pending,
        notices: S.notices,
        pastTenants: S.pastTenants,
        admin: { user: S.admin.user, isDefault: !!S.admin.isDefault }
      };
    } else {
      const r = roomOf(S, roomN);
      const notices = {};
      if (S.notices[roomN]) notices[roomN] = S.notices[roomN];
      v = {
        rooms: r ? [strip(r)] : [],
        pay: S.pay.filter(p => p.room === roomN),
        payArchive: [],
        pending: S.pending.filter(p => p.room === roomN),
        notices: notices,
        pastTenants: [],
        admin: {}
      };
    }
    return JSON.parse(JSON.stringify(v));
  }

  // Upgrades older data: plain-text PINs/passwords become hashes, tenants get an id.
  function migrate(S, ctx) {
    normalize(S);
    let ch = false;
    S.rooms.forEach(r => {
      const t = r.t;
      if (!t) return;
      if (t.pinHash === undefined) {
        t.pinHash = ctx.hashPin(String(t.pin || "1234"));
        ch = true;
      } else if (ctx.secure && String(t.pinHash).indexOf("plain:") === 0) {
        t.pinHash = ctx.hashPin(t.pinHash.slice(6));
        ch = true;
      }
      if (t.pin !== undefined) {
        delete t.pin;
        ch = true;
      }
      if (!t.tid) {
        t.tid = ctx.newTid();
        ch = true;
      }
    });
    const ad = S.admin;
    const plainHash = ad.hash && String(ad.hash).indexOf("plain:") === 0;
    if (ad.pass !== undefined || !ad.hash || (ctx.secure && plainHash)) {
      const pw = ad.pass !== undefined ? String(ad.pass) : plainHash ? ad.hash.slice(6) : "admin123";
      S.admin = { user: ad.user || "admin", hash: ctx.hashPass(pw), v: ad.v || 0, isDefault: pw === "admin123" };
      ch = true;
    }
    return ch;
  }

  return {
    apply: apply,
    login: login,
    viewFor: viewFor,
    migrate: migrate,
    normalize: normalize,
    dueActive: dueActive,
    dueFor: dueFor,
    prevMonth: prevMonth,
    nextMonth: nextMonth,
    ADVANCE_KINDS: ADVANCE_KINDS,
    prorated: prorated
  };
})();

/* ==========================================================================
   Server (Google Apps Script). build.py joins logic.js + this file into
   GoogleAppsScript.gs — paste THAT file into Apps Script.

   Security model:
   - The data (sheet "AppState") is never returned whole. Each request carries a
     signed login token; the admin gets everything except PIN/password hashes,
     a tenant gets only their own room.
   - Every change is an action checked by the same rules as the app (Logic.apply).
   - PINs and the admin password are stored only as salted SHA-256 hashes.
   - Five wrong logins lock that room/user for 15 minutes.
   ========================================================================== */

var STATE_SHEET = "AppState";

function jsonOut(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

/* ---------- Secrets, hashing, tokens ---------- */

// Random per-installation secrets, created on first use and kept in Script Properties.
var SECRETS_ = {};
function secret_(name) {
  if (SECRETS_[name]) return SECRETS_[name];
  var p = PropertiesService.getScriptProperties();
  var v = p.getProperty(name);
  if (!v) {
    v = Utilities.getUuid() + Utilities.getUuid();
    p.setProperty(name, v);
  }
  return (SECRETS_[name] = v);
}

function hex_(bytes) {
  return bytes
    .map(function (b) {
      var v = (b + 256) % 256;
      return (v < 16 ? "0" : "") + v.toString(16);
    })
    .join("");
}

function hashWith_(kind, value) {
  var d = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    secret_("SALT") + "|" + kind + "|" + value,
    Utilities.Charset.UTF_8
  );
  return "s1:" + hex_(d);
}

function sign_(body) {
  return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(body, secret_("TOKEN_KEY")));
}

// Logins do not time out (10-year expiry, renewed on every sync). They still end at
// once when the admin changes the tenant's PIN or moves them out, or changes the
// admin password — that is how to sign someone out, e.g. after a lost phone.
function makeToken_(claims) {
  claims.exp = Date.now() + 3650 * 864e5;
  var body = Utilities.base64EncodeWebSafe(JSON.stringify(claims));
  return body + "." + sign_(body);
}

// Returns { role, room } for a valid token, or null. Tokens stop working when the
// admin password or a tenant's PIN changes, or when the tenant moves out.
function verify_(token, S) {
  var parts = String(token || "").split(".");
  if (parts.length !== 2 || sign_(parts[0]) !== parts[1]) return null;
  var c;
  try {
    c = JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(parts[0])).getDataAsString());
  } catch (e) {
    return null;
  }
  if (!c || c.exp < Date.now()) return null;
  if (c.r === "admin") return c.av === (S.admin.v || 0) ? { role: "admin" } : null;
  var r = S.rooms.filter(function (x) {
    return x.t && x.t.tid === c.tid;
  })[0];
  if (!r || (r.t.pv || 0) !== c.pv) return null;
  return { role: "tenant", room: r.n };
}

function tokenFor_(S, who) {
  if (who.role === "admin") return makeToken_({ r: "admin", av: S.admin.v || 0 });
  var r = S.rooms.filter(function (x) {
    return x.n === who.room;
  })[0];
  return makeToken_({ r: "tenant", tid: r.t.tid, pv: r.t.pv || 0 });
}

/* ---------- Login rate limit ---------- */

function tooMany_(key) {
  return Number(CacheService.getScriptCache().get(key) || 0) >= 5;
}

function addFail_(key) {
  var c = CacheService.getScriptCache();
  c.put(key, String(Number(c.get(key) || 0) + 1), 900);
}

/* ---------- Context for Logic.apply ---------- */

function ctx_(ss, who) {
  var tz = ss.getSpreadsheetTimeZone();
  var now = new Date();
  return {
    role: who ? who.role : "",
    room: who ? who.room : "",
    now: now.getTime(),
    month: Utilities.formatDate(now, tz, "yyyy-MM"),
    day: Number(Utilities.formatDate(now, tz, "d")),
    today: Utilities.formatDate(now, tz, "yyyy-MM-dd"),
    secure: true,
    hashPin: function (p) {
      return hashWith_("pin", p);
    },
    checkPin: function (h, p) {
      return !!h && h === hashWith_("pin", p);
    },
    hashPass: function (p) {
      return hashWith_("pass", p);
    },
    checkPass: function (h, p) {
      return !!h && h === hashWith_("pass", p);
    },
    upload: function (dataUrl, name) {
      return uploadBase64ToDrive(dataUrl, name + "_" + now.getTime() + ".jpg");
    },
    newTid: function () {
      return Utilities.getUuid();
    }
  };
}

/* ---------- Entry points ---------- */

// Health check, plus the occupied room numbers for the login page's room picker.
// Nothing else (no names, no data) is served without a login.
function doGet(e) {
  var res = { ok: true, app: "hongthaew", v: 2 };
  try {
    var S = readState_(SpreadsheetApp.getActiveSpreadsheet());
    if (S && Array.isArray(S.rooms)) {
      res.rooms = S.rooms
        .filter(function (r) {
          return r.t;
        })
        .map(function (r) {
          return r.n;
        });
    }
  } catch (err) {}
  return jsonOut(res);
}

function doPost(e) {
  var req;
  try {
    req = JSON.parse((e && e.postData && e.postData.contents) || "{}");
  } catch (err) {
    return jsonOut({ ok: false, error: "Bad request" });
  }
  if (!req.action) {
    return jsonOut({ ok: false, error: "ແອັບເວີຊັນເກົ່າ. ກະລຸນາໂຫຼດໜ້າເວັບໃໝ່." });
  }
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return jsonOut({ ok: false, error: "ເຊີບເວີຫຍຸ້ງ, ກະລຸນາລອງໃໝ່" });
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var S = readState_(ss);
    var dirty = false;
    if (S === null) {
      // Data exists but could not be read: stop rather than risk saving over it.
      return jsonOut({ ok: false, error: "ອ່ານຂໍ້ມູນບໍ່ໄດ້ ກະລຸນາລອງໃໝ່" });
    }
    if (!Array.isArray(S.rooms)) {
      S = { rooms: [] }; // first run: empty building, admin / admin123 until changed
      dirty = true;
    }
    Logic.normalize(S);
    if (Logic.migrate(S, ctx_(ss, null))) dirty = true;

    var res;
    if (req.action === "login") res = login_(S, req, ss);
    else if (req.action === "sync") res = sync_(S, req, ss);
    else if (req.action === "import") res = import_(S, req, ss);
    else res = { ok: false, error: "Unknown action" };

    if (res.newState) {
      S = res.newState;
      delete res.newState;
    }
    if (res.dirty) dirty = true;
    delete res.dirty;
    if (dirty) writeState_(ss, S);
    var c = ctx_(ss, null);
    res.now = c.now;
    res.month = c.month;
    return jsonOut(res);
  } catch (err) {
    return jsonOut({ ok: false, error: String((err && err.message) || err) });
  } finally {
    lock.releaseLock();
  }
}

function login_(S, req, ss) {
  var key = "lf:" + req.mode + ":" + String(req.id || "").toLowerCase().slice(0, 40);
  if (tooMany_(key)) return { ok: false, error: "ລອງຜິດຫຼາຍເທື່ອເກີນໄປ. ກະລຸນາລໍຖ້າ 15 ນາທີ." };
  var who;
  try {
    who = Logic.login(S, req.mode, req.id, req.secret, ctx_(ss, null));
  } catch (err) {
    addFail_(key);
    return { ok: false, error: err.message };
  }
  CacheService.getScriptCache().remove(key);
  return {
    ok: true,
    token: tokenFor_(S, who),
    role: who.role,
    room: who.room || "",
    view: Logic.viewFor(S, who.role, who.room)
  };
}

// Applies the device's queued actions in order (each checked separately), then
// returns that person's fresh view and a renewed token.
function sync_(S, req, ss) {
  var who = verify_(req.token, S);
  if (!who) return { ok: false, auth: true, error: "ກະລຸນາເຂົ້າສູ່ລະບົບໃໝ່" };
  var results = [];
  var changed = false;
  (req.ops || []).slice(0, 50).forEach(function (op) {
    try {
      Logic.apply(S, op, ctx_(ss, who));
      results.push({ ok: true });
      changed = true;
    } catch (err) {
      results.push({ ok: false, error: err.message });
    }
    // A room rename moves the tenant; find them again by their tenant id.
    if (who.role === "tenant") who = findTenant_(S, req.token) || who;
  });
  if (who.role === "tenant" && !findTenant_(S, req.token)) {
    return { ok: false, auth: true, error: "ກະລຸນາເຂົ້າສູ່ລະບົບໃໝ່", dirty: changed };
  }
  return {
    ok: true,
    results: results,
    token: tokenFor_(S, who),
    role: who.role,
    room: who.room || "",
    view: Logic.viewFor(S, who.role, who.room),
    dirty: changed
  };
}

// Re-finds a tenant by the id inside their (already verified) token, so a room rename
// in the same batch does not lose them.
function findTenant_(S, token) {
  try {
    var c = JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(String(token).split(".")[0])).getDataAsString());
    if (c.r !== "tenant") return null;
    var r = S.rooms.filter(function (x) {
      return x.t && x.t.tid === c.tid;
    })[0];
    return r ? { role: "tenant", room: r.n } : null;
  } catch (e) {
    return null;
  }
}

// Admin only: replace everything with data uploaded from a device (e.g. data that was
// kept on one phone before the Sheet was connected). The current admin login is kept.
function import_(S, req, ss) {
  var who = verify_(req.token, S);
  if (!who || who.role !== "admin") return { ok: false, auth: !who, error: "ບໍ່ມີສິດ" };
  var N = req.state;
  if (!N || !Array.isArray(N.rooms)) return { ok: false, error: "ຂໍ້ມູນບໍ່ຖືກຕ້ອງ" };
  Logic.normalize(N);
  N.admin = S.admin;
  Logic.migrate(N, ctx_(ss, null));
  saveImagesToDrive(N);
  return { ok: true, newState: N, token: tokenFor_(N, who), role: "admin", room: "", view: Logic.viewFor(N, "admin"), dirty: true };
}

/* ---------- Storage ---------- */

// Returns the saved data, {} when nothing has been saved yet, or null when data is
// there but cannot be read (the caller must then not write anything).
function readState_(ss) {
  var sh = ss.getSheetByName(STATE_SHEET);
  var json = "";
  if (sh && sh.getLastRow() >= 1) {
    var vals = sh.getRange(1, 1, sh.getLastRow(), 1).getValues();
    for (var i = 0; i < vals.length; i++) json += vals[i][0] || "";
  }
  if (!json || json === "{}") return {};
  try {
    return JSON.parse(json);
  } catch (e) {
    return null;
  }
}

// Payment types shown in the Payments sheet (keys match PAY_KINDS in logic.js).
var PAY_TYPES = {
  rent: "ຄ່າເຊົ່າ (Rent)",
  elec: "ຄ່າໄຟຟ້າ (Electric)",
  water: "ຄ່ານ້ຳ (Water)",
  garbage: "ຄ່າຂີ້ເຫຍື້ອ (Garbage)"
};

// Only real links go in the readable sheets: a base64 image (failed Drive upload) can
// exceed the 50,000-character cell limit and break the save.
function cellUrl(v) {
  return typeof v === "string" && v.indexOf("data:") !== 0 ? v : "";
}

// Rewriting a tab is the slowest step of a save, so a tab is only rewritten when its
// contents changed (e.g. a new slip changes "Payments" but not "Rooms").
function writeTable_(ss, name, rows) {
  var cache = CacheService.getScriptCache();
  var key = "tbl:" + name;
  var sig = hex_(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, JSON.stringify(rows), Utilities.Charset.UTF_8));
  if (cache.get(key) === sig && ss.getSheetByName(name)) return;
  var sh = ss.getSheetByName(name) || ss.insertSheet(name);
  sh.clearContents();
  sh.getRange(1, 1, rows.length, rows[0].length).setValues(rows);
  sh.getRange(1, 1, 1, rows[0].length).setFontWeight("bold");
  cache.put(key, sig, 21600);
}

function writeState_(ss, S) {
  // 1. Full data, in 45,000-character chunks (the sheet "AppState" — keep it private).
  var raw = JSON.stringify(S);
  var st = ss.getSheetByName(STATE_SHEET) || ss.insertSheet(STATE_SHEET);
  st.clear();
  var rows = [];
  for (var pos = 0; pos < raw.length; pos += 45000) rows.push([raw.slice(pos, pos + 45000)]);
  if (!rows.length) rows.push(["{}"]);
  st.getRange(1, 1, rows.length, 1).setValues(rows);

  var month = Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), "yyyy-MM");

  // 2. Rooms (no PINs — they are only stored as hashes).
  var rRows = [[
    "ເລກຫ້ອງ (Room)", "ສະຖານະ (Status)", "ຄ່າເຊົ່າ (Rent)", "ຍອດຕ້ອງຈ່າຍ (Due)",
    "ຊື່ຜູ້ເຊົ່າ (Tenant Name)", "ວັນເດືອນປີເກີດ (DOB)", "ເບີໂທ (Phone)", "ບັດປະຊາຊົນ/ພາສປອດ (ID)",
    "ຕິດຕໍ່ສຸກເສີນ (Emergency)", "ເລກໄຟຟ້າ (Electric)", "ເລກນ້ຳ (Water)", "ວັນເຂົ້າພັກ (Move-in Date)",
    "ເງິນມັດຈຳ (Deposit)", "ຮູບໂປຣໄຟລ໌ (Photo URL)"
  ]];
  S.rooms.forEach(function (r) {
    var t = r.t || {};
    rRows.push([
      r.n, r.t ? "ມີຜູ້ເຊົ່າ" : "ຫວ່າງ", r.rent || 0, Logic.dueFor(r, month) || 0,
      t.name || "", t.dob || "", t.phone || "", t.idno || "", t.emerg || "", t.elec || "", t.water || "",
      t.since || "", r.t ? t.deposit || 0 : "", cellUrl(t.photo)
    ]);
  });
  writeTable_(ss, "Rooms", rRows);

  // 3. Payments (live and moved-out).
  var pRows = [[
    "ID", "ເລກຫ້ອງ (Room)", "ເດືອນ (Month)", "ປະເພດ (Type)", "ຈຳນວນເງິນລວມ (Total)",
    "ລາຍລະອຽດ (Breakdown)", "ສະຖານະ (Status)", "ເຫດຜົນປະຕິເສດ (Reason)", "ວັນເວລາສົ່ງ (Submitted)",
    "ລິ້ງຮູບສະລິບ (Slip URL)", "ຍ້າຍອອກແລ້ວ (Moved out)", "ໝາຍເຫດ (Note)"
  ]];
  S.pay.concat(S.payArchive).forEach(function (p) {
    var ks = kindsOf(p);
    pRows.push([
      p.id, p.room, p.month,
      ks.map(function (k) { return PAY_TYPES[k] || k; }).join(", "),
      p.amount,
      p.items ? ks.map(function (k) { return (PAY_TYPES[k] || k) + ": " + p.items[k]; }).join(" + ") : "",
      p.status, p.reason || "", p.ts ? new Date(p.ts).toISOString() : "", cellUrl(p.img), p.archived ? "✓" : "",
      (p.manual ? "ແອດມິນບັນທຶກ · " + methodLabel(p) + (p.note ? ": " : "") : "") + (p.note || "")
    ]);
  });
  writeTable_(ss, "Payments", pRows);

  // 4. Past tenants and their deposits.
  var mRows = [[
    "ເລກຫ້ອງ (Room)", "ຊື່ (Name)", "ເບີໂທ (Phone)", "ບັດ (ID)", "ວັນເຂົ້າພັກ (Moved in)",
    "ວັນຍ້າຍອອກ (Moved out)", "ເງິນມັດຈຳ (Deposit)", "ຄືນເງິນມັດຈຳ (Refunded)", "ໝາຍເຫດ (Note)"
  ]];
  S.pastTenants.forEach(function (x) {
    mRows.push([x.room, x.name, x.phone, x.idno, x.since, x.out, x.deposit || 0, x.refund || 0, x.note || ""]);
  });
  writeTable_(ss, "MovedOut", mRows);
}

/* ---------- Google Drive uploads ---------- */

// The folder id is remembered so it is not searched for on every upload. Each file is
// viewable by link so the app can show it; links are only sent to people allowed to
// see that room.
function getUploadFolder() {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty("UPLOAD_FOLDER");
  if (id) {
    try {
      return DriveApp.getFolderById(id);
    } catch (e) {}
  }
  var folders = DriveApp.getFoldersByName("Courtyard_Uploads");
  var folder = folders.hasNext() ? folders.next() : DriveApp.createFolder("Courtyard_Uploads");
  props.setProperty("UPLOAD_FOLDER", folder.getId());
  return folder;
}

// Saves a base64 data URL to Drive and returns a link an <img> tag can show.
function uploadBase64ToDrive(base64Data, filename) {
  if (!base64Data || typeof base64Data !== "string" || base64Data.indexOf("data:") !== 0) {
    return base64Data;
  }
  try {
    var parts = base64Data.split(",");
    var contentType = parts[0].split(":")[1].split(";")[0];
    var blob = Utilities.newBlob(Utilities.base64Decode(parts[1]), contentType, filename);
    var file = getUploadFolder().createFile(blob);
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    return "https://lh3.googleusercontent.com/d/" + file.getId();
  } catch (err) {
    return base64Data;
  }
}

// Used for imported data: uploads any photos and slips still stored as base64.
function saveImagesToDrive(S) {
  S.rooms.forEach(function (r) {
    if (r.t && r.t.photo && r.t.photo.indexOf("data:image") === 0) {
      r.t.photo = uploadBase64ToDrive(r.t.photo, "tenant_room_" + r.n + "_" + Date.now() + ".jpg");
    }
  });
  S.pending.forEach(function (p) {
    if (p.ch && p.ch.photo && p.ch.photo.indexOf("data:image") === 0) {
      p.ch.photo = uploadBase64ToDrive(p.ch.photo, "pending_room_" + p.room + "_" + Date.now() + ".jpg");
    }
  });
  S.pay.concat(S.payArchive).forEach(function (p) {
    if (p.img && p.img.indexOf("data:image") === 0) {
      p.img = uploadBase64ToDrive(p.img, "slip_room_" + p.room + "_" + (p.month || "pay") + "_" + p.id + ".jpg");
    }
  });
}
